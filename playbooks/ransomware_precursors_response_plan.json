        "10": {
          "customCode": "def select_response_plan(action=None, success=None, container=None, results=None, handle=None, filtered_artifacts=None, filtered_results=None, custom_function=None, **kwargs):\n    phantom.debug(\"select_response_plan() called\")\n\n    user = json.loads(phantom.get_run_data(key='get_effective_user:username'))\n    message = \"\"\"Ransomware Precursors detected (e.g., VSS deletion, backup tampering, shadow copy removal).\\nSelect a response plan to execute. Only playbooks tagged 'ransomware_response_option' are shown.\"\"\"\n\n    playbook_list = phantom.collect2(container=container, datapath=[\"list_response_playbooks:custom_function_result.data.*.full_name\"], action_results=results)\n    playbook_list = [item[0] for item in playbook_list]\n\n    # Fallback static options if none are tagged yet\n    if not playbook_list:\n        playbook_list = [\n            \"Ransomware - Precursors - Aggressive Containment\",\n            \"Ransomware - Precursors - Quarantine Only\",\n            \"Ransomware - Precursors - Monitor & Hunt\"\n        ]\n    playbook_list.append(\"Do Nothing\")\n\n    response_types = [{\n        \"prompt\": \"Response Plan\",\n        \"options\": {\"type\": \"list\", \"choices\": playbook_list}\n    }]\n\n    phantom.prompt2(container=container, user=user, message=message, respond_in_mins=30, name=\"select_response_plan\", response_types=response_types, callback=user_response_decision)\n    return",
          "data": {
